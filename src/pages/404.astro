---
import { getEntry, render } from 'astro:content'

import Default from '@/layouts/Default.astro'
import Toasty from '@/features/guru-meditation/components/Toasty.astro'

const page = await getEntry('page', '404')
const { Content } = await render(page)

const { slug: url, data } = page
const { name, description } = data
---

<Default
  title={name}
  {description}
  url={`/${url}`}
  theme="dark"
  class="grid min-h-screen w-full items-center justify-center"
>
  <Toasty>
    <Content />
  </Toasty>
</Default>
