---
import { Layout } from '@/layouts/layout'
import { Kickstart } from '@/features/kickstart'
import { getEntry } from 'astro:content'

const entry = await getEntry('pages', 'ram-disk')

if (!entry) return Astro.redirect('404')

const { data } = entry
const { title, description } = data
---

<Layout {title} {description} intent="kickstart">
  <Kickstart />
</Layout>
