---
import { Layout } from '@/layouts'
import { Requester, Action, Cycle, Radio, Text, Display } from '@/gadgets'

const menu = {
  name: 'Menu',
  items: [
    {
      name: 'Workbench',
      items: [
        {
          name: 'Backdrop...',
        },
        {
          name: 'Execute command...',
        },
        {
          name: 'About command...',
        },
        {
          name: 'Quit command...',
        },
      ],
    },
    { name: 'Window', items: [] },
    { name: 'Icons', items: [] },
    { name: 'Tools', items: [] },
  ],
}
---

<Layout>
  <div x-data x-popover:group class="flex h-6 gap-8 bg-foreground text-secondary">
    {menu.items.map((item) => (
      <div x-popover class="relative">
        <button
          x-popover:button
          type="button"
          class="whitespace-nowrap bg-foreground text-secondary px-0.5 hover:bg-white hover:text-primary focus:bg-white focus:text-primary"
        >
          {item.name}
        </button>

        <div
          x-popover:panel
          class="absolute top-4.5 left-0 min-w-48 z-10 bg-foreground text-secondary outline-none border-2 border-secondary"
          x-cloak
        >
          <a
            href="#profile"
            class="whitespace-nowrap block bg-foreground p-0.5 hover:bg-white hover:text-primary focus:bg-white focus:text-primary"
          >
            Profile
          </a>
        </div>
      </div>
    ))}
  </div>
</Layout>
