---
import { Requester, Action, Cycle, Radio, Text, Display } from '@/gadgets'
import { Layout } from '@/layouts'

const menu = {
  name: 'Menu',
  items: [
    {
      name: 'Workbench',
      items: [
        {
          name: 'Backdrop...',
        },
        {
          name: 'Execute command...',
        },
        {
          name: 'About...',
        },
        {
          name: 'Quit...',
        },
      ],
    },
    {
      name: 'Window',
      items: [
        {
          name: 'New drawer',
        },
        {
          name: 'Open parent',
        },
        { name: 'Close' },
        { name: 'Update' },
        { name: 'Select Contents' },
        { name: 'Clean Up' },
        { name: 'Snapshot' },
        { name: 'Show' },
        { name: 'View By' },
      ],
    },
    { name: 'Icons', items: [] },
    { name: 'Tools', items: [] },
  ],
}
---

<Layout>
  <div x-data x-popover:group class="flex h-6 gap-8 bg-foreground text-secondary">
    {menu.items.map((item) => (
      <div x-popover class="relative">
        <button
          x-popover:button
          type="button"
          class="bg-foreground px-0.5 whitespace-nowrap text-secondary hover:bg-white hover:text-primary focus:bg-white focus:text-primary"
        >
          {item.name}
        </button>

        <div
          x-popover:panel
          class="absolute top-4.5 left-0 z-10 min-w-48 border-2 border-secondary bg-foreground text-secondary outline-none"
          x-cloak
        >
          {item.items.map((item) => (
            <a
              href="#profile"
              class="block bg-foreground p-0.5 whitespace-nowrap hover:bg-white hover:text-primary focus:bg-white focus:text-primary"
            >
              {item.name}
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>
</Layout>
