---
import { getCollection, render } from 'astro:content'

import { SITE } from '@/config'
import Workbench from '@/layouts/Workbench.astro'
import Work from '@/features/work/Work.astro'

export async function getStaticPaths() {
  const entries = await getCollection('work')
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { data } = entry
const { name, description, image, tags, url } = data

const { Content } = await render(entry)

const title = `${name} - Work - ${SITE.name}`
// const url = `work/${id}`
// const keywords = tags.map(tag => tag)

// let selectedTags = null
// if (tags) selectedTags = await getEntries(tags)

const meta = { title, name, description, url, image }
---

<Workbench {...meta}>
  <div class="bg-secondary absolute inset-10 z-20 overflow-auto border-2 p-4">
    <pre>{JSON.stringify(entry, null, 2)}</pre>
  </div>
  <Work {entry}>
    <Content />
  </Work>
</Workbench>
