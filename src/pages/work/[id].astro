---
import { getCollection } from 'astro:content'
import { Workbench } from '@/layouts'
import { Nav } from '@/components'
import { Window } from '@/gadgets'
import { Work } from '@/features/work'

export async function getStaticPaths() {
  const entries = await getCollection('work', ({ data }) => import.meta.env.DEV || !data.draft)
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { data } = entry
const { name, description } = data

const work = (await getCollection('work', ({ data }) => !data.draft)).map((item) => ({
  name: item.data.name,
  url: `/work/${item.id}`,
}))
---

<Workbench title={name} {description}>
  <Work {entry} />

  {work && (
    <Window title="Work" close="/work">
      <Nav id="work" name="work" items={work} />
    </Window>
  )}
</Workbench>
