---
import { Requester, Action, Cycle, Radio, Text, Display, Window } from '@/gadgets'
import { Layout } from '@/layouts'
---

<Layout>
  <div class="grid gap-4 p-6">
    <div class="flex gap-6">
      <Action label="Ok" href="#foo" />
      <Action label="Cancel" href="#cancel" intent="ghosted" />

      <div class="flex items-center gap-2">
        <label for="cycle">Cycle</label>
        <Cycle id="cycle" />
      </div>

      <div class="flex items-center gap-2">
        <label for="engine">Engine</label>
        <Radio id="engine" name="engine" />
      </div>

      <div class="flex items-center gap-2">
        <label for="text">Text</label>
        <Text id="text" />
      </div>
    </div>

    <dl class="grid grid-cols-[auto_1fr] gap-2">
      <dt class="self-center text-end text-background">Name:</dt>
      <Display as="dd">Foo</Display>
      <dt class="self-center text-end text-background">Longer name:</dt>
      <Display as="dd">Foo</Display>
    </dl>
  </div>
  <Requester open>
    <Window title="Workbench" padding={false} close={false} zoom={false} depth={false}>
      <div class="bg-white bg-foo p-2">
        <Display class="bg-secondary p-4">
          <p>
            Kickstart version 37.350
            <br />
            Workbench version 37.67
            <br />
            <br />
            Copyright © 2000-2019
            <br />
            Lance Guyatt, Inc.
            <br />
            All Rights Reserved
          </p>
        </Display>
        <div class="pt-2 text-center">
          <Action>Ok</Action>
        </div>
      </div>
    </Window>
  </Requester>
</Layout>
