---
import { Layout } from '@/layouts'
import { Requester, Action, Cycle, Radio, Text, Display } from '@/gadgets'
---

<Layout>
  <div class="grid gap-4 p-6">
    <div class="flex gap-6">
      <Action label="Ok" href="#foo" />
      <Action label="Cancel" href="#cancel" intent="ghosted" />

      <div class="gap-2 flex items-center">
        <label for="cycle">Cycle</label>
        <Cycle id="cycle" />
      </div>

      <div class="gap-2 flex items-center">
        <label for="engine">Engine</label>
        <Radio id="engine" name="engine" />
      </div>

      <div class="gap-2 flex items-center">
        <label for="text">Text</label>
        <Text id="text" />
      </div>
    </div>

    <dl class="grid grid-cols-[auto_1fr] gap-2">
      <dt class="text-background text-end self-center">Name:</dt>
      <Display as="dd">Foo</Display>
      <dt class="text-background text-end self-center">Longer name:</dt>
      <Display as="dd">Foo</Display>
    </dl>
  </div>
  <Requester>dsd</Requester>
</Layout>
