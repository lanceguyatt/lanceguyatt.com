---
import { BaseHead } from '@/components'
import { type SiteProps, SITE } from '@/config'
import '@/styles/global.css'
import { type HTMLAttributes } from 'astro/types'
import { z } from 'astro/zod'
import { tv } from 'tailwind-variants'

export const layoutSchema = z.object({
  theme: z.string().optional(),
})

type Props = SiteProps & HTMLAttributes<'html'> & z.infer<typeof layoutSchema>

const layoutVariants = tv({
  slots: {
    base: 'scroll-smooth antialiased',
    body: 'cursor-amiga',
  },
})

const { title, name, description, url, image, theme, class: className } = Astro.props

const meta = { name, title, description, url, image }

const { base, body } = layoutVariants()
---

<html lang={SITE.lang} class={base({ class: className })}>
  <head>
    <BaseHead {...meta}>
      <slot name="head" />
    </BaseHead>
  </head>
  <body class={body()} data-theme={theme}>
    <slot />
  </body>
</html>
