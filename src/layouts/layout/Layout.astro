---
import { BaseHead } from '@/components/baseHead'
import { DevTools } from '@/components/devTools'
import { type SiteProps, SITE } from '@/config'
import { cn } from '@/lib/utils'
import '@/styles/global.css'
import { type HTMLAttributes } from 'astro/types'
import { z } from 'astro/zod'

export const layoutSchema = z.object({
  theme: z.string().optional(),
})

export type LayoutProps = SiteProps &
  HTMLAttributes<'html'> &
  z.infer<typeof layoutSchema>

const {
  title,

  name,
  description,
  url,
  image,
  theme,
  class: className,
} = Astro.props as LayoutProps

const meta = { name, title, description, url, image }
---

<html lang={SITE.lang} class="scroll-smooth antialiased">
  <head>
    <BaseHead {...meta}>
      <slot name="head" />
    </BaseHead>
  </head>
  <body
    class:list={['cursor-(--cursor-amiga)', cn(className)]}
    data-theme={theme}
  >
    <slot />
    <DevTools />
  </body>
</html>
