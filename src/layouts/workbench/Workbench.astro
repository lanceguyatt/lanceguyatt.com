---
import { Layout } from '@/layouts/layout'
import { Titlebar, Nav, Window } from '@/components'
import { getEntry } from 'astro:content'

const nav = await getEntry('nav', 'main')

const { title } = Astro.props
---

<Layout>
  <div class="">
    <Titlebar>Lance Guyatt, Web Developer. 2000-2026 All Rights Reserved</Titlebar>
    <main>
      <slot />
      <Window title="Nav" intent="foo">
        <Nav {...nav.data} vertical />
      </Window>
    </main>
  </div>
</Layout>
