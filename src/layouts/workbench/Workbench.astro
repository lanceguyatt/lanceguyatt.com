---
import { getEntry } from 'astro:content'

import { Titlebar, Nav } from '@/components'
import { SITE } from '@/config'
import { Window } from '@/gadgets'
import { Layout } from '@/layouts'

const nav = await getEntry('nav', 'main')

const { title, description } = Astro.props
---

<Layout {title} {description}>
  <div class="">
    <Titlebar>
      {SITE.title} 2000-{SITE.copyrightYear} All Rights Reserved
    </Titlebar>
    <main>
      <slot />
      <Window close="/kickstart">{nav && <Nav {...nav.data} vertical />}</Window>
    </main>
  </div>
</Layout>
