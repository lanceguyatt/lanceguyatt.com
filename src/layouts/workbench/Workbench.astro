---
import { getEntry } from 'astro:content'

import { Titlebar, Nav } from '@/components'
import { SITE } from '@/config'
import { Window } from '@/gadgets'
import { Layout } from '@/layouts'

const nav = await getEntry('nav', 'main')

const { title, description } = Astro.props
---

<Layout {title} {description}>
  <a
    href="#main"
    class="sr-only bg-white px-2 text-black focus:not-sr-only focus:fixed focus:top-0 focus:left-0 focus:z-50"
  >
    Skip to content
  </a>
  <div class="">
    <Titlebar>
      {SITE.title} 2000-{SITE.copyrightYear} All Rights Reserved
    </Titlebar>
    <main id="main" tabindex="-1">
      <h1 class="sr-only">{title ?? SITE.name}</h1>
      <slot />
      <Window close="/kickstart">{nav && <Nav {...nav.data} vertical />}</Window>
    </main>
  </div>
</Layout>
