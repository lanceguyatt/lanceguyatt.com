---
import { Alert } from '@/components'
import { Image } from 'astro:assets'
import toastyImg from '@/assets/images/toasty.png'
---

<article
  x-load="idle"
  x-data="guruMeditation"
  x-init="$watch('toasty', value => { if (value) setTimeout(() => (toasty = false), 500) })"
  class="bg-black text-white overflow-hidden w-screen relative min-h-dvh p-6 grid items-center justify-center"
>
  <Alert animate open aria-labelledby="alertLabel">
    <p>
      <span id="alertLabel" role="heading" aria-level="2">
        Software Failure.
      </span>
      <a href="/">
        Press left mouse button to continue<span class="absolute inset-0 block"></span>
      </a>
    </p>
    <p>Guru Meditation #00004040.00004040</p>
  </Alert>

  <audio x-ref="toastyAudio" preload="none">
    <source src="/audio/toasty.mp3" type="audio/mp3" />
  </audio>

  <div
    class="size-50 absolute inset-e-0 bottom-0"
    x-cloak
    x-show="toasty"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="translate-x-50"
    x-transition:enter-end="translate-x-0"
    x-transition:leave="transition ease-in duration-300"
    x-transition:leave-start="translate-x-0"
    x-transition:leave-end="translate-x-50"
  >
    <Image src={toastyImg} alt="" width={200} height={200} class="object-cover" loading="lazy" />
  </div>
</article>
