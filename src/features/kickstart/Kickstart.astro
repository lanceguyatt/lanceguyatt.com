---
import Prose from '@/components/Prose.astro'
import Loading from '@/features/kickstart/components/Loading.astro'
---

<div
  class:list={[
    'flex min-h-screen flex-col items-center justify-center gap-6 border p-6',
    'md:flex-row md:items-end md:justify-between md:gap-12 md:p-12',
  ]}
>
  <div class="border">
    <Prose class="max-w-44">
      <slot />
    </Prose>
  </div>

  <div class="border">
    <Loading />
  </div>
</div>
