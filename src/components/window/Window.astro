---
import type { HTMLAttributes } from 'astro/types'
import { z } from 'astro/zod'
import { tv, type VariantProps } from 'tailwind-variants'
import { Depth, Zoom } from '@/components'
import Close from './components/Close.astro'

export const windowSchema = z.object({
  close: z.string().optional(),
  title: z.string().optional(),
  full: z.number().optional(),
  free: z.number().optional(),
  remainer: z.number().optional(),
  zoom: z.boolean().optional(),
  depth: z.boolean().optional(),
})

const windowVariants = tv({
  slots: {
    base: 'window relative grid w-screen',
    header: 'absolute -inset-x-2 -top-5.5 flex h-5 px-1',
    main: 'bg-secondary row-span-2 h-full p-2',
  },
  variants: {
    intent: {
      primary: { base: 'bg-red-900 text-black' },
      secondary: { base: 'bg-secondary text-black' },
      foo: { base: 'bg-white' },
    },
  },
  defaultVariants: { intent: 'primary' },
})

type Props = (HTMLAttributes<'article'> | HTMLAttributes<'section'> | HTMLAttributes<'dialog'>) &
  z.infer<typeof windowSchema> &
  VariantProps<typeof windowVariants> & {
    as?: 'article' | 'section' | 'dialog'
  }

const {
  as: Tag = 'section',
  close = '/',
  title,
  intent,
  full = 85,
  free = 128,
  remainer = 708,
  zoom = true,
  depth = true,
  class: className,
} = Astro.props

const { base, header, main } = windowVariants({ intent })
---

<Tag class={base({ class: className })}>
  <header class={header()}>
    <div class="flex">
      <Close href={close}>Close window</Close>
    </div>

    <div class="flex-auto">
      <div class="truncate overflow-hidden flex">
        <h2 class="sr-only">{title}</h2>
        <div class="flex-auto">
          {full}% full, {free}k free, {remainer}k
        </div>
      </div>
    </div>

    <div class="flex ml-auto">
      {zoom && <Zoom />}
      {depth && <Depth />}
    </div>
  </header>
  <div class={main()}>
    <slot />
  </div>
</Tag>

<style is:global>
  .window {
    border-width: 22px 4px 4px 4px;
    border-image: url(/images/window.svg) 22 4 4 4 stretch;
    height: calc(100dvh - 22px);
  }
</style>
