---
import type { HTMLAttributes } from 'astro/types'
import { z } from 'astro/zod'
import { tv, type VariantProps } from 'tailwind-variants'
import { Depth } from '@/components'
import { Icon } from 'astro-icon/components'

export const windowSchema = z.object({
  name: z.string(),
  close: z
    .object({
      name: z.string(),
      href: z.string(),
    })
    .optional(),
})

const windowVariants = tv({
  slots: {
    base: 'window relative grid grid-rows-[auto_1fr]',
    header: 'window-header absolute -inset-x-1.5 -top-5 flex h-4 items-center bg-amber-500',
    content: 'window-content bg-secondary p-2',
  },
  variants: {
    intent: {
      primary: { base: 'bg-primary text-black' },
      secondary: { base: 'bg-secondary text-primary' },
    },
  },
  defaultVariants: { intent: 'primary' },
})


export type WindowProps = HTMLAttributes<'section'> & z.infer<typeof windowSchema> & VariantProps<typeof windowVariants>

const {
  name,
  class: className,
  intent,
  close = {
    name: 'Close',
    href: '/',
  },
} = Astro.props as WindowProps


const { base, header, content } = windowVariants({ intent })
---

<section class={base({ class: className })}>
  <div class={header()}>
    {close ? (
      <a href={close.href} aria-label={close.name}>
        <Icon name="close" />
      </a>
    ) : null}
    <div class="flex-auto bg-amber-300">{name}</div>
    <Depth />
  </div>
  <div class={content()}>
    <slot />
  </div>
</section>

<style is:global>
  .window {
    border-width: 22px 4px 4px 4px;
    border-image: url(/images/window.svg) 22 4 4 4 stretch;
  }
</style>
