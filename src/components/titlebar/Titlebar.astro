---
import { Depth } from '@/components'
import { type HTMLAttributes } from 'astro/types'
import { z } from 'astro/zod'
import { tv, type VariantProps } from 'tailwind-variants'

export const titlebarSchema = z.object({
  depth: z.boolean().optional(),
})

const titlebarVariants = tv({
  slots: {
    base: 'h-titlebar flex items-center gap-1',
    wrapper: 'flex-1 overflow-hidden text-ellipsis whitespace-nowrap',
  },
  variants: {
    intent: {
      black: { base: 'text-secondary bg-black' },
      white: { base: 'bg-white text-black' },
      primary: { base: 'bg-primary text-primary-foreground' },
      secondary: { base: 'bg-secondary text-secondary-foreground' },
    },
  },
  defaultVariants: { intent: 'black' },
})

export type TitleProps = HTMLAttributes<'div'> &
  z.infer<typeof titlebarSchema> &
  VariantProps<typeof titlebarVariants>

const { class: className, depth = true, intent } = Astro.props as TitleProps

const { base, wrapper } = titlebarVariants({ intent })
---

<header class={base({ class: className })}>
  <slot name="prefix" />
  <div class={wrapper()}>
    <slot />
  </div>
  <slot name="suffix">{depth && <Depth class="bg-background" />}</slot>
</header>
