---
import { type HTMLAttributes } from 'astro/types'
import { tv } from 'tailwind-variants'
import { z } from 'astro:content'
import { Depth } from '@/components/depth'
import { cn } from '@/lib/utils'

export const titlebarSchema = z.object({
  color: z.enum(['black', 'white', 'primary', 'secondary']).optional(),
  depth: z.boolean().optional(),
})

export type TitleProps = HTMLAttributes<'div'> & z.infer<typeof titlebarSchema>

const {
  class: className,
  depth = true,
  color = 'black',
  ...props
} = Astro.props as TitleProps

const titlebar = tv({
  slots: {
    base: 'h-titlebar flex items-center gap-1',
    wrapper: 'flex-1 overflow-hidden text-ellipsis whitespace-nowrap',
  },
  variants: {
    color: {
      black: 'bg-black text-secondary',
      white: 'bg-white text-black',
      primary: 'bg-primary text-primary-foreground',
      secondary: 'bg-secondary text-secondary-foreground',
    },
  },
  defaultVariants: { color: 'black' },
})

const { base, wrapper } = titlebar();
---

<div
  data-component="titlebar"
  class:list={[cn(base({ color }), className)]}
  {...props}
>
  <slot name="prefix" />
  <div
    class={wrapper()}
  >
    <slot />
  </div>
  <slot name="suffix">
    {depth && <Depth class="bg-background" />}
  </slot>
</div>
