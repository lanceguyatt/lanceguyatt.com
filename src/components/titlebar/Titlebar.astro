---
import { Depth } from '@/components'
import { type HTMLAttributes } from 'astro/types'
import { z } from 'astro/zod'
import { tv, type VariantProps } from 'tailwind-variants'

export const titlebarSchema = z.object({
  color: z.enum(['black', 'white', 'primary', 'secondary']).optional(),
  depth: z.boolean().optional(),
})

const titlebarVariants = tv({
  slots: {
    base: 'h-titlebar flex items-center gap-1',
    wrapper: 'flex-1 overflow-hidden text-ellipsis whitespace-nowrap',
  },
  variants: {
    color: {
      black: 'text-secondary bg-black',
      white: 'bg-white text-black',
      primary: 'bg-primary text-primary-foreground',
      secondary: 'bg-secondary text-secondary-foreground',
    },
  },
  defaultVariants: { color: 'black' },
})


export type TitleProps = HTMLAttributes<'div'> & z.infer<typeof titlebarSchema> & VariantProps<typeof titlebarVariants>

const { class: className, depth = true, color = 'black' } = Astro.props as TitleProps


const { base, wrapper } = titlebarVariants({ color })
---

<div data-component="titlebar" class={base({ class: className })}>
  <slot name="prefix" />
  <div class={wrapper()}>
    <slot />
  </div>
  <slot name="suffix">
    {depth && <Depth class="bg-background" />}
  </slot>
</div>
