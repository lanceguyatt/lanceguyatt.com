---
import { type HTMLAttributes } from 'astro/types'
import { z } from 'astro/zod'
import { tv, type VariantProps } from 'tailwind-variants'

export const alertSchema = z.object({})

const alertVariants = tv({
  slots: {
    base: 'relative border-4 p-8',
  },
  variants: {
    intent: {
      destructive: 'border-red-500 text-red-500',
    },
    animate: {
      true: 'animate-alternate animate-(--animate-foo)',
    },
  },
  defaultVariants: {
    intent: 'destructive',
    animate: false,
  },
})

export type AlertProps = HTMLAttributes<'div'> &
  z.infer<typeof alertSchema> &
  VariantProps<typeof alertVariants>

const { intent, animate = false, class: className } = Astro.props as AlertProps

const { base } = alertVariants({ intent, animate })
---

<div role="dialog" class={base({ class: className })}>
  <slot />
</div>

<style is:global>
  @reference "tailwindcss";

  [data-component='alert'] {
    & a {
      @apply hover:underline;

      &::before {
        @apply absolute inset-0 z-0 block content-[""];
      }
    }
  }
</style>
