---
import { type HTMLAttributes } from 'astro/types'
import { tv, type VariantProps } from 'tailwind-variants'

type Props = HTMLAttributes<'dialog'> & VariantProps<typeof alertVariants>

const { intent, animate = false, class: className, ...rest } = Astro.props

const alertVariants = tv({
  slots: {
    base: 'm-auto border-4 bg-transparent p-8 text-center',
  },
  variants: {
    intent: {
      destructive: 'border-red-500 text-red-500',
    },
    animate: {
      true: 'animate-alternate animate-(--animate-foo)',
    },
  },
  defaultVariants: {
    intent: 'destructive',
    animate: false,
  },
})

const { base } = alertVariants({ intent, animate })
---

<dialog class={base({ class: className })} {...rest}>
  <slot />
</dialog>
