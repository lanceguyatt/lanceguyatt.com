---
import { Link } from '@/components/link'
import { type HTMLAttributes } from 'astro/types'
import { z } from 'astro/zod'
import { tv, type VariantProps } from 'tailwind-variants'

export const navSchema = z.object({
  id: z.string(),
  name: z.string(),
  items: z.array(
    z.object({
      name: z.string(),
      url: z.string(),
      icon: z.string(),
    }),
  ),
})

type Props = HTMLAttributes<'nav'> & z.infer<typeof navSchema> & VariantProps<typeof navVariants>

const pathname = new URL(Astro.request.url).pathname

const { id, name, items, vertical, class: className, ...rest } = Astro.props

const navVariants = tv({
  slots: {
    base: 'nav bg-lime-500',
    list: 'flex gap-3',
    item: 'border',
  },
  variants: {
    vertical: {
      true: { list: 'w-24 flex-col items-center' },
      false: { list: 'flex-wrap' },
    },
  },
  defaultVariants: {
    vertical: false,
  },
})

const { base, list, item } = navVariants({ vertical })
---

<nav aria-labelledby={id} class={base({ class: className })} {...rest}>
  <h2 {id} class="sr-only">
    {name}
  </h2>
  {items?.length > 0 && (
    <ul class={list()}>
      {items.map(({ name, url, icon }) => (
        <li class={item()}>
          <Link {icon} href={url} active={pathname.includes(url)}>
            {name}
          </Link>
        </li>
      ))}
    </ul>
  )}
</nav>
