---
import { tv } from 'tailwind-variants'
import { z } from 'astro/zod'
import type { HTMLAttributes } from 'astro/types'

export const navLinkSchema = z.object({
  name: z.string(),
  url: z.string(),
  current: z.boolean().optional(),
  external: z.boolean().optional(),
  type: z.enum(['disk', 'drawer', 'drive', 'file']).optional(),
})

type Props = z.infer<typeof navLinkSchema> & {
  class?: string
} & Omit<HTMLAttributes<'a'>, 'href' | 'class'>

const {
  name,
  current = false,
  class: className,
  external,
  url,
  type = 'drawer',
  ...rest
} = Astro.props

const navLinkVariants = tv({
  slots: {
    base: 'link group focus:bg-primary flex flex-col items-center gap-1 text-base focus:text-white',
    sprite: '',
  },
  variants: {
    type: {
      disk: { sprite: 'h-[46px] w-[43px] bg-disk group-focus:bg-position-[-43px_0]' },
      drawer: {
        sprite: 'h-[38px] w-[65px] bg-drawer group-focus:bg-position-[-65px_0]',
      },
      drive: {
        sprite: 'h-[44px] w-[85px] bg-drive group-focus:bg-position-[-85px_0]',
      },
      file: { sprite: 'h-[62px] w-[46px] bg-file group-focus:bg-position-[-46px_0]' },
    },
    current: {
      true: {},
      false: {},
    },
  },
  compoundVariants: [
    {
      type: 'disk',
      current: true,
      class: { sprite: 'bg-position-[-43px_0]' },
    },
    {
      type: 'drive',
      current: true,
      class: { sprite: 'bg-position-[-85px_0]' },
    },
  ],
  defaultVariants: {
    type: 'drawer',
    current: false,
  },
})

const { base, sprite } = navLinkVariants({ type, current })
---

<a
  href={url}
  class={base({ class: className })}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  aria-current={current ? 'page' : undefined}
  {...rest}
>
  <span class={sprite()} />
  <slot>{name}</slot>
</a>

<style>
  .link {
    @apply text-center;
  }
</style>
