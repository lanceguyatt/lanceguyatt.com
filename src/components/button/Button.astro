---
import type { HTMLAttributes } from 'astro/types'
import { cn } from '@/lib/utils'
import { tv } from 'tailwind-variants'
import { z } from 'astro/zod'

export const buttonSchema = z.object({
  intent: z.enum([
    'default',
    'destructive',
    'outline',
    'secondary',
    'ghost',
    'link',
  ]),
  width: z.enum(['auto', 'full']),
  size: z.enum(['default', 'sm', 'lg']),
})

export type ButtonProps = z.infer<typeof buttonSchema> &
  HTMLAttributes<'button'> &
  Omit<HTMLAttributes<'a'>, 'type'>

const button = tv({
  slots: {
    base: 'button inline-flex items-center justify-center whitespace-nowrap',
  },
  variants: {
    intent: {
      default: 'text-primary-foreground active:bg-primary',
      destructive:
        'bg-destructive text-destructive-foreground hover:bg-destructive/90',
      outline:
        'border-2 border-input hover:bg-accent hover:text-accent-foreground',
      secondary: 'bg-secondary text-secondary-foreground hover:bg-secondary/80',
      ghost: 'hover:bg-accent hover:text-accent-foreground',
      link: 'underline-offset-4 hover:underline text-primary',
    },
    width: {
      auto: '',
      full: 'w-full',
    },
    size: {
      default: 'h-6 px-2 text-base/tighter',
      sm: 'h-9 px-3 ',
      lg: 'h-11 px-8',
    },
  },
  defaultVariants: {
    intent: 'default',
    size: 'default',
    width: 'auto',
  },
})

const {
  as: Comp = 'a',
  class: className,
  intent,
  ...props
} = Astro.props as ButtonProps
const { base } = button()
---

<Comp
  data-component="button"
  class:list={[cn(base({ intent }), className)]}
  {...props}
>
  <slot />
</Comp>
