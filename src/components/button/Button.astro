---
import type { HTMLAttributes } from 'astro/types'
import { tv, type VariantProps } from 'tailwind-variants'
import { z } from 'astro/zod'

export const buttonSchema = z.object({})

const buttonVariants = tv({
  slots: {
    base: 'button inline-flex items-center justify-center whitespace-nowrap',
  },
  variants: {
    intent: {
      default: 'text-primary-foreground active:bg-primary',
      destructive: 'bg-destructive text-destructive-foreground hover:bg-destructive/90',
      outline: 'border-input hover:bg-accent hover:text-accent-foreground border-2',
      secondary: 'bg-secondary text-secondary-foreground hover:bg-secondary/80',
      ghost: 'hover:bg-accent hover:text-accent-foreground',
      link: 'text-primary underline-offset-4 hover:underline',
    },
    width: {
      auto: '',
      full: 'w-full',
    },
    size: {
      default: 'text-base/tighter h-6 px-2',
      sm: 'h-9 px-3',
      lg: 'h-11 px-8',
    },
  },
  defaultVariants: {
    intent: 'default',
    size: 'default',
    width: 'auto',
  },
})

export type ButtonProps = z.infer<typeof buttonSchema> & HTMLAttributes<'button'> & Omit<HTMLAttributes<'a'>, 'type'> & VariantProps<typeof buttonVariants>

const { as: Comp = 'a', class: className, intent } = Astro.props as ButtonProps

const { base } = buttonVariants({ intent })
---

<Comp data-component="button" class={base({ className })}>
  <slot />
</Comp>
