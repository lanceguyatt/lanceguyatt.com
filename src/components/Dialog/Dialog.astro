---
// import Button from '@/components/Button.astro'
import Close from '@/components/Close.astro'

export type DialogProps = {
  id?: string
  name: string
  isDialogOpen?: boolean
}

const { name, id, isDialogOpen = false } = Astro.props as DialogProps
---

<div x-data={`{ open: ${isDialogOpen} }`} class="flex justify-center">
  <div
    x-dialog
    x-model="open"
    style="display: none"
    class="fixed inset-0 z-10 overflow-y-auto"
  >
    <div
      x-dialog:overlay
      x-transition.opacity
      class="bg-opacity-50 fixed inset-0 bg-black"
    >
    </div>

    <div
      class="relative flex min-h-screen justify-center lg:items-center lg:p-4"
    >
      <div
        x-dialog:panel
        x-transition.opacity
        class="border-foreground grid-rows-[22px, 1fr] relative grid min-h-80 w-full border-2 bg-white lg:max-w-xl"
        {id}
      >
        <div
          class="bg-primary h-titlebar grid grid-cols-[auto,1fr] items-center"
        >
          <Close type="button" @click="$dialog.close()" class="outline-0" />
          <h2
            x-dialog:title
            class="text-base/tighter flex-auto overflow-hidden px-1 text-ellipsis whitespace-nowrap"
          >
            {name}
          </h2>
        </div>

        <div class="bg-secondary foverflow-auto p-3">
          <slot />
        </div>
      </div>
    </div>
  </div>
</div>
