---
import Button from '@/components/Button.astro'
import Close from '@/components/Close.astro'

type Props = {
  name: string
  isDialogOpen?: boolean
}

const { name, isDialogOpen = false } = Astro.props
---

<div x-data={`{ open: ${isDialogOpen} }`} class="flex justify-center">
  <!-- <Button as="button" x-on:click="open = true" type="button">
    Open dialog
  </Button> -->

  <div
    x-dialog
    x-model="open"
    style="display: none"
    class="fixed inset-0 overflow-y-auto z-10"
  >
    <div
      x-dialog:overlay
      x-transition.opacity
      class="fixed inset-0 bg-black bg-opacity-50"
    >
    </div>

    <div class="relative min-h-screen flex items-center justify-center lg:p-4">
      <div
        x-dialog:panel
        x-transition
        class="relative lg:max-w-xl w-full bg-white grid grid-rows-[auto, 1fr, auto]"
      >
        <div class="grid items-center grid-cols-[auto,1fr]">
          <Close type="button" @click="$dialog.close()" class="outline-0" />
          <h2
            x-dialog:title
            class="text-base/tighter flex-auto overflow-hidden text-ellipsis whitespace-nowrap px-1"
          >
            {name}
          </h2>
        </div>

        <div>
          <slot />
        </div>

        <div class="p-4 flex justify-end space-x-2 bg-gray-50 rounded-b-xl">
          <Button x-on:click="$dialog.close()" type="button"> Cancel </Button>
          <Button x-on:click="$dialog.close()" type="button"> Confirm </Button>
        </div>
      </div>
    </div>
  </div>
</div>
