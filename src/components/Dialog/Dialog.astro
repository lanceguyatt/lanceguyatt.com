---
// import Button from '@/components/Button.astro'
import Close from '@/components/Close.astro'

export type DialogProps = {
  id?: string
  name: string
  isDialogOpen?: boolean
}

const { name, id, isDialogOpen = false } = Astro.props as DialogProps
---

<div x-data={`{ open: ${isDialogOpen} }`} class="flex justify-center">
  <div
    x-dialog
    x-model="open"
    style="display: none"
    class="fixed inset-0 overflow-y-auto z-10"
  >
    <div
      x-dialog:overlay
      x-transition.opacity
      class="fixed inset-0 bg-black bg-opacity-50"
    >
    </div>

    <div
      class="relative min-h-screen flex justify-center lg:p-4 lg:items-center"
    >
      <div
        x-dialog:panel
        x-transition.opacity
        class="relative border-2 min-h-80 border-foreground lg:max-w-xl w-full bg-white grid grid-rows-[22px, 1fr]"
        {id}
      >
        <div
          class="bg-primary grid items-center grid-cols-[auto,1fr] h-titlebar"
        >
          <Close type="button" @click="$dialog.close()" class="outline-0" />
          <h2
            x-dialog:title
            class="text-base/tighter flex-auto overflow-hidden text-ellipsis whitespace-nowrap px-1"
          >
            {name}
          </h2>
        </div>

        <div class="bg-secondary foverflow-auto p-3">
          <slot />
        </div>
      </div>
    </div>
  </div>
</div>
