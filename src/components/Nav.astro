---
import { type HTMLAttributes } from 'astro/types'
import { Link } from '@/components/index.astro'

type NavItemProps = {
  item: any
}

export type NavProps = HTMLAttributes<'nav'> & {
  name: string
  id: string
  items: NavItemProps[]
  isVertical: boolean
}
const pathname = new URL(Astro.request.url).pathname

const {
  class: className,
  name,
  items,
  id,
  isVertical = true,
} = Astro.props as NavProps
---

<nav aria-labelledby={id} class:list={[className]}>
  <h2 {id} class="sr-only">{name}</h2>
  {
    items?.length > 0 && (
      <ul
        class:list={[
          'flex',
          'gap-3',
          isVertical ? 'w-24 flex-col items-center' : 'flex-wrap',
        ]}
      >
        {items.map((item) => (
          <li>
            <Link
              icon={item.data.icon}
              href={`/${item.slug}`}
              active={pathname.includes(item.slug)}
            >
              {item.data.name}
            </Link>
          </li>
        ))}
      </ul>
    )
  }
</nav>
