---
import { SEO } from 'astro-seo'
import { Font } from 'astro:assets'

import { SITE, type SiteProps } from '@/config'

export type BaseHeadProps = {
  title?: string
  description?: string
  url?: string
  image?: SiteProps['image']
  noindex?: boolean
}

type Props = BaseHeadProps

const {
  title = SITE.name,
  description = SITE.description,
  url = Astro.url.pathname,
  image = SITE.image,
  noindex = false,
} = Astro.props

const canonical = new URL(url, Astro.site).href
const imageUrl = image?.url ? new URL(image.url, Astro.site).href : undefined
---

<>
  <meta name="charset" content="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <SEO
    {title}
    titleTemplate={`%s - ${SITE.name}`}
    titleDefault={`Lance Guyatt`}
    {description}
    {canonical}
    {noindex}
    openGraph={{
      basic: {
        title: title as string,
        type: 'webpage',
        image: imageUrl ?? '',
        url: canonical,
      },
      optional: {
        description,
        locale: SITE.locale,
        siteName: SITE.name,
      },
      image: {
        width: image?.width,
        height: image?.height,
        alt: image?.alt,
      },
    }}
    twitter={{
      card: 'summary_large_image',
    }}
    extend={{
      link: [
        { rel: 'icon', type: 'image/svg+xml', href: '/favicon.svg' },
        { rel: 'author', type: 'text/plain', href: '/humans.txt' },
        {
          rel: 'manifest',
          href: '/site.webmanifest',
          crossOrigin: 'anonymous',
        },
        {
          rel: 'apple-touch-icon',
          href: '/apple-touch-icon.png',
        },
      ],
      meta: [{ name: 'theme-color', content: SITE.themeColor }],
    }}
  />
  <slot />
  <Font cssVariable="--font-topaz" preload />
</>
