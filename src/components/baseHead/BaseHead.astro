---
import { SEO } from 'astro-seo'
import { SITE } from '@/config'
import { Font } from 'astro:assets'
import { z } from 'astro:content'

export const baseHeadSchema = z.object({
  title: z.string().optional(),
  description: z.string().optional(),
  url: z.string().optional(),
  image: z.string().optional(),
  noindex: z.boolean().optional(),
})

export type BaseHeadProps = z.infer<typeof baseHeadSchema>

const {
  title = SITE.name,
  description = SITE.description,
  url = '/',
  image = SITE.image,
  noindex = false,
} = Astro.props as BaseHeadProps
---

<>
  <meta name="charset" content="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <SEO
    {title}
    titleTemplate={`%s - ${SITE.name}`}
    titleDefault={`Lance Guyatt`}
    {description}
    canonical={`${SITE.url}${url}`}
    {noindex}
    openGraph={{
      basic: {
        title: title as string,
        type: 'webpage',
        image: `${SITE.url}${image?.url}`,
        url: `${SITE.url}${url}`,
      },
      optional: {
        description,
        locale: SITE.locale,
        siteName: SITE.name,
      },
      image: {
        width: image?.width,
        height: image?.height,
        alt: image?.alt,
      },
    }}
    twitter={{
      card: 'summary_large_image',
      site: SITE.twitter,
      creator: SITE.twitter,
    }}
    extend={{
      link: [
        { rel: 'icon', type: 'image/svg+xml', href: '/favicon.svg' },
        { rel: 'author', type: 'text/plain', href: '/humans.txt' },
        {
          rel: 'mainfest',
          href: '/manifest.webmanifest',
          crossOrigin: 'anonymous',
        },
        {
          rel: 'apple-touch-icon',
          href: '/apple-touch-icon.png',
        },
      ],
      meta: [{ name: 'theme-color', content: SITE.themeColor }],
    }}
  />
  <slot />
  <Font cssVariable="--topaz" preload />
</>
