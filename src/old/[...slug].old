---
import { getCollection, render } from 'astro:content'

import Workbench from '@/layouts/Workbench.astro'
// import Window from '@/components/Window.astro'
// import Prose from '@/components/Prose.astro'
// import Dialog from '@/components/Dialog/Dialog.astro'

export async function getStaticPaths() {
  const pageEntries = await getCollection('page')
  return pageEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { data, slug } = entry
const { name, description } = data

const { Content } = await render(entry)

const { pathname } = Astro.url
---

<Workbench title={name} {description} url={`/${slug}`}>
  <!-- <Window
    id={id}
    {name}
    level={1}
    active={pathname === `/${id}`}
    depth
    zoom
    url="/"
  >
    <div class="w-full max-w-xl">
      <Prose>
        <Content />
      </Prose>
    </div>
  </Window> -->
  <!-- <Dialog {name} isDialogOpen="true">
    <Prose>
      <Content />
    </Prose>
  </Dialog> -->
</Workbench>
