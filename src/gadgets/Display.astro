---
// import type { HTMLAttributes } from 'astro/types'
import { tv } from 'tailwind-variants'

const { as: Comp = 'div', class: className, ...rest } = Astro.props

const displayVariants = tv({
  base: 'border-display min-h-6 px-0.5',
})
---

<Comp class={displayVariants({ class: className })} {...rest}>
  <slot />
</Comp>
