---
import { type HTMLAttributes } from 'astro/types'
import { z } from 'astro/zod'

import { cn } from '@/lib/utils'

export const depthSchema = z.object({
  label: z.string().optional(),
})

export type DepthProps = HTMLAttributes<'button'> & z.infer<typeof depthSchema>

const { label = 'Toggle depth', class: className, ...rest } = Astro.props as DepthProps
---

<button
  type="button"
  class:list={[
    'bg-depth',
    cn('inline-block h-titlebar w-5.75 active:bg-position-[-23px_0]', className),
  ]}
  {...rest}
>
  <span class="sr-only">{label}</span>
</button>
