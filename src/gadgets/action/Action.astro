---
import type { HTMLAttributes } from 'astro/types'
import { tv, type VariantProps } from 'tailwind-variants'
import { z } from 'astro/zod'

export const actionSchema = z.object({})

const actionVariants = tv({
  slots: {
    base: 'action text-overflow inline-block border-2 text-center whitespace-nowrap',
  },
  variants: {
    intent: {
      default: 'text-primary-foreground active:bg-primary',
      destructive: 'bg-destructive text-destructive-foreground hover:bg-destructive/90',
      outline: 'border-input hover:bg-accent hover:text-accent-foreground border-2',
      secondary: 'bg-secondary text-secondary-foreground hover:bg-secondary/80',
      ghost: 'hover:bg-accent hover:text-accent-foreground',
      link: 'text-primary underline-offset-4 hover:underline',
    },
    width: {
      auto: '',
      full: 'w-full',
    },
    size: {
      default: 'h-6 px-2 text-base/5',
      sm: 'h-9 px-3',
      lg: 'h-11 px-8',
    },
  },
  defaultVariants: {
    intent: 'default',
    size: 'default',
    width: 'auto',
  },
})

export type ActionProps = z.infer<typeof actionSchema> &
  HTMLAttributes<'button'> &
  Omit<HTMLAttributes<'a'>, 'type'> &
  VariantProps<typeof actionVariants>

const { as: Comp = 'a', size, width, intent, class: className } = Astro.props as ActionProps

const { base } = actionVariants({ intent, size, width })
---

<Comp class={base({ class: className })}>
  <slot />
</Comp>
