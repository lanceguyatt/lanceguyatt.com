---
import type { HTMLAttributes } from 'astro/types'
import { tv, type VariantProps } from 'tailwind-variants'

const actionVariants = tv({
  base: [
    'border-action inline-block h-(--action-h) px-(--action-px) text-center whitespace-nowrap',
    'text-overflow outline-0 focus-visible:bg-primary',
  ],
  variants: {
    intent: {
      default: 'text-primary-foreground active:bg-primary',
      ghosted: 'pointer-events-none hover:bg-accent hover:text-accent-foreground',
    },
    width: {
      auto: '',
      full: 'w-full',
    },
    size: {
      default: '[--action-h:--spacing(6)] [--action-px:--spacing(2)] text-base/5',
      sm: '[--action-h:--spacing(9)] [--action-px:--spacing(3)]',
      lg: '[--action-h:--spacing(11)] [--action-px:--spacing(8)]',
    },
  },
  defaultVariants: {
    intent: 'default',
    size: 'default',
    width: 'auto',
  },
})

type BaseProps = {
  label?: string
  class?: string
} & VariantProps<typeof actionVariants>

type AnchorProps = BaseProps & { as?: 'a' } & Omit<HTMLAttributes<'a'>, 'class'>
type ButtonProps = BaseProps & { as: 'button' } & Omit<HTMLAttributes<'button'>, 'class'>

export type ActionProps = AnchorProps | ButtonProps

const {
  as: Comp = 'a',
  label,
  size,
  width,
  intent,
  class: className,
  ...rest
} = Astro.props as ActionProps

const ghosted = intent === 'ghosted'

// Loosely typed on purpose: a dynamic tag is checked against both <a> and
// <button> attributes at once, so strict per-element typing lives in ActionProps.
const attrs: Record<string, unknown> = {
  ...rest,
  ...(Comp === 'button'
    ? { disabled: ghosted }
    : ghosted
      ? { 'aria-disabled': 'true', tabindex: -1 }
      : {}),
}
---
<Comp class={actionVariants({ intent, size, width, class: className })} {...attrs}>
  <slot>{label}</slot>
</Comp>

<style is:global>
  .action:active {
    border-image: url("data:image/svg+xml,%3Csvg width='14' height='24' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill-rule='nonzero' fill='none'%3E%3Cpath d='M0 0h14v2H0V0zm0 22h1v2H0v-2zM0 2h2v20H0V2z' fill='%23000'/%3E%3Cpath d='M1 22h13v2H1v-2zM12 2h2v20h-2V2zm1-2h1v2h-1V0z' fill='%23FFF'/%3E%3C/g%3E%3C/svg%3E") 2 / 1 / 0 stretch;
  }
</style>
