---
import type { HTMLAttributes } from 'astro/types'

import { tv } from '@/lib/tv'

const closeVariants = tv({
  base: 'inline-block h-titlebar w-5 bg-close active:bg-position-[-20px_0]',
})

type Props = (HTMLAttributes<'a'> | HTMLAttributes<'button'>) & {
  as?: 'a' | 'button'
}

const { as = 'a', class: className, ...rest } = Astro.props
---

{as === 'button' ? (
  <button class={closeVariants({ class: className })} {...(rest as HTMLAttributes<'button'>)}>
    <span class="sr-only">
      <slot />
    </span>
  </button>
) : (
  <a class={closeVariants({ class: className })} {...(rest as HTMLAttributes<'a'>)}>
    <span class="sr-only">
      <slot />
    </span>
  </a>
)}
