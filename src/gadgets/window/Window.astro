---
import type { HTMLAttributes } from 'astro/types'
import { z } from 'astro/zod'
import { tv, type VariantProps } from 'tailwind-variants'

import { Depth, Zoom } from '@/gadgets'
import Close from '@/gadgets/Close.astro'

export const windowSchema = z.object({
  close: z.string().optional(),
  title: z.string().optional(),
  full: z.number().optional(),
  free: z.number().optional(),
  remainer: z.number().optional(),
  zoom: z.boolean().optional(),
  depth: z.boolean().optional(),
})

const windowVariants = tv({
  slots: {
    base: 'relative border-window',
    header: 'absolute -top-5 -right-[3px] -left-[3px] flex h-4.5',
    main: 'h-full bg-secondary',
  },
  variants: {
    intent: {
      primary: { header: 'bg-primary', base: '' },
      secondary: { base: 'bg-secondary text-black' },
      foo: { base: 'bg-white' },
    },
    type: {
      default: { base: '' },
    },
    padding: {
      true: {
        main: 'p-2',
      },
    },
  },
  defaultVariants: { intent: 'primary', padding: true },
})

type WindowProps = (
  | HTMLAttributes<'article'>
  | HTMLAttributes<'section'>
  | HTMLAttributes<'dialog'>
) &
  z.infer<typeof windowSchema> &
  VariantProps<typeof windowVariants> & {
    as?: 'article' | 'section' | 'dialog'
  }

const {
  as: Tag = 'section',
  close = '/',
  title,
  intent,
  full,
  free,
  remainer,
  zoom = true,
  depth = true,
  type,
  padding,
  class: className,
} = Astro.props as WindowProps

const { base, header, main } = windowVariants({ intent, type, padding })
---

<Tag class={base({ class: className })}>
  <header class={header()}>
    {close && (
      <div class="flex">
        <Close href={close}>Close window</Close>
      </div>
    )}

    <div class="flex-auto px-2">
      <div class="flex truncate overflow-hidden">
        <h2>{title}</h2>

        {full && (
          <div class="flex-auto">
            {full}% full, {free}k free, {remainer}k
          </div>
        )}
      </div>
    </div>

    <div class="ml-auto flex">
      {zoom && <Zoom />}
      {depth && <Depth />}
    </div>
  </header>
  <div class={main()}>
    <slot />
  </div>
</Tag>

<style is:global>
  .window {
    border-width: 22px 4px 4px 4px;
    border-image: url(/images/window.svg) 22 4 4 4 stretch;
    /*min-height: calc(100dvh - 22px);*/
  }
</style>
